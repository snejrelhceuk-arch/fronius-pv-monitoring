#!/bin/bash
# =============================================================
# Git Pre-Commit Hook — Role-Guard + Publish-Guard + Doc-Check
#                       + Volkszaehlung-Autoupdate
# =============================================================
#
# Verhindert Commits auf Nicht-Primary-Hosts, blockiert staged Inhalte mit
# sensiblen Mustern aus .publish-guard, erzeugt doc/volkszaehlung.md bei Code-/
# Doku-Aenderung neu und fuehrt den Doku-Pre-Commit-Check aus.
#
# Installation:
#   ./scripts/install_hooks.sh
#
# Override für Notfälle (z.B. Failover wurde zum Primary):
#   GIT_ALLOW_COMMIT=1 git commit -m "emergency fix"
#
# Siehe doc/DUAL_HOST_ARCHITECTURE.md Abschnitt 9.
# =============================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
ROLE_FILE="${REPO_ROOT}/.role"
GUARD_FILE="${REPO_ROOT}/.publish-guard"

# --- Notfall-Override ---
if [ "${GIT_ALLOW_COMMIT:-0}" = "1" ]; then
    echo "⚠️  GIT_ALLOW_COMMIT=1 gesetzt → Commit-Sperre umgangen."
    exit 0
fi

# --- Rolle lesen ---
ROLE="primary"
if [ -f "$ROLE_FILE" ]; then
    ROLE="$(head -1 "$ROLE_FILE" | tr -d '[:space:]')"
fi

# --- Guard ---
if [ "$ROLE" != "primary" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  ❌  COMMIT BLOCKIERT — dieser Host ist '$ROLE'         ║"
    echo "║                                                          ║"
    echo "║  Entwicklung und Commits nur auf dem PRIMARY-Host (181). ║"
    echo "║  Code-Änderungen werden per sync_code_to_peer.sh        ║"
    echo "║  vom Primary hierher synchronisiert.                     ║"
    echo "║                                                          ║"
    echo "║  Notfall-Override:                                       ║"
    echo "║    GIT_ALLOW_COMMIT=1 git commit -m 'emergency fix'     ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

# Primary-Host → Commit erlaubt

# --- Volkszaehlung: bei Code-/Doku-Aenderung neu erzeugen + mitstagen ---
if git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '\.(py|md|sh|html|js|css|sql|json|ya?ml|toml)$'; then
    if python3 "$REPO_ROOT/tools/generate_volkszaehlung.py" >/dev/null 2>&1; then
        git add "$REPO_ROOT/doc/volkszaehlung.md" 2>/dev/null || true
    fi
fi

# --- Publish-Guard: staged Dateien gegen Sperrmuster prüfen ---
if [ -f "$GUARD_FILE" ]; then
    PATTERNS=$(grep -vE '^\s*(#|$)' "$GUARD_FILE" | paste -sd'|' -)
    if [ -n "$PATTERNS" ]; then
        FOUND=0
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            # Nur Dateien prüfen, die im Index existieren
            if ! git cat-file -e ":$f" 2>/dev/null; then
                continue
            fi

            MATCHES=$(git show ":$f" | grep -nE "$PATTERNS" | head -5 || true)
            if [ -n "$MATCHES" ]; then
                if [ "$FOUND" -eq 0 ]; then
                    echo ""
                    echo "🚫 COMMIT BLOCKIERT — Sensible Daten in staged Dateien:"
                fi
                FOUND=1
                echo "  ✗ $f:"
                echo "$MATCHES" | sed 's/^/      /'
            fi
        done < <(git diff --cached --name-only --diff-filter=ACMR)

        if [ "$FOUND" -eq 1 ]; then
            echo ""
            echo "Bitte Inhalte bereinigen oder in .publish-guard/.gitignore sauber modellieren."
            echo "Notfall-Bypass: GIT_ALLOW_COMMIT=1 git commit ..."
            echo ""
            exit 1
        fi
    fi
fi

# --- Doku-Guard (Cards / Index / Anchors) ---
python3 "$REPO_ROOT/tools/pre_commit_doc_check.py"

exit 0
