# Private Infrastruktur-Overrides fuer lokale Laufzeit
# Diese Datei als .infra.local kopieren und mit echten Werten befuellen.

# Optional: LAN-Parameter (werden sonst automatisch aus dem Default-Route-Interface erkannt)
# PV_LAN_IFACE=eth0
# PV_LAN_CIDR=192.0.2.0/24
# PV_LAN_GATEWAY=192.0.2.1
# PV_DNS_PRIMARY=192.0.2.1
# PV_VPN_CIDR=10.8.0.0/24

# Optional: Kritische Host-Liste fuer Wartungs-Checks (name=ip, kommasepariert)
# PV_CRITICAL_HOSTS=failover=192.0.2.105,laptop=192.0.2.106,ollama=192.0.2.116,f1=192.0.2.122,f2=192.0.2.123,f3=192.0.2.124,wattpilot=192.0.2.176,pv=192.0.2.181,backup=192.0.2.195,nq=192.0.2.204

PV_INVERTER_IP=192.0.2.122
PV_FAILOVER_IP=192.0.2.105
PV_FAILOVER_USER=failover-user
PV_FAILOVER_PV_BASE=/srv/pv-system
PV_FAILOVER_HOST=failover-user@failover-host

PV_PRIMARY_HOST=primary-user@primary-host
PV_PRIMARY_IP=192.0.2.181
PV_PRIMARY_REPO=/srv/pv-system
PV_PRIMARY_DB_PATH=/srv/pv-system/data.db

PV_WATTPILOT_IP=192.0.2.176
PV_SECONDARY_INVERTER_API=http://192.0.2.123/components/readable
# URL mit & / ? MUSS gequotet werden (.infra.local wird von scripts/load_infra_env.sh via `source` gelesen).
PV_TERTIARY_INVERTER_API="http://192.0.2.124/solar_api/v1/GetInverterRealtimeData.cgi?Scope=Device&DeviceId=1&DataCollection=CommonInverterData"

PV_PI5_BACKUP_HOST=backup-user@backup-host
PV_PI5_BACKUP_DB_PATH=/srv/pv-system/data.db
PV_PI5_BACKUP_BASE=/srv/pv-system/backup/db

# ── Workspace-Redundanz-Sync auf alle Pi (scripts/sync_workspace_all_hosts.sh) ──
# Leerzeichen-getrennte user@host-Liste (Failover + Auxiliary-Hosts).
# Nur Code-Redundanz; Rolle steuert das Verhalten (nicht divergenter Code).
PV_SYNC_HOSTS="user@192.0.2.195 user@192.0.2.105 user@192.0.2.181"
PV_SYNC_REMOTE_PATH=Dokumente/PVAnlage/pv-system

PV_OLLAMA_SSH_HOST=ollama-host

PV_NOTIFICATION_EMAIL=alerts@example.invalid
PV_NOTIFICATION_SMTP_HOST=smtp.example.invalid
PV_NOTIFICATION_SMTP_USER=alerts@example.invalid
PV_NOTIFICATION_FROM=alerts@example.invalid

# ── Wärmepumpe (WP) Modbus-Transport (REFORMATION) ──────────────────────────
# local  = direktes RS485/tty auf diesem Host (nur Pi4-Tech / Bridge-Host).
# remote = HTTP an die Pi4-Tech Bridge (Primary/Failover ohne WP-Hardware).
# PV_WP_BACKEND_MODE=local
# PV_WP_REMOTE_BASE_URL=http://192.0.2.181:8091
# PV_WP_REMOTE_TIMEOUT_S=5
# Token: bevorzugt in .secrets als PV_WP_REMOTE_TOKEN ablegen (nicht hier).
# PV_WP_REMOTE_TOKEN=

# Bridge-seitig (nur Pi4-Tech):
# PV_WP_BRIDGE_BIND=0.0.0.0
# PV_WP_BRIDGE_PORT=8091
# PV_WP_BRIDGE_TOKEN=            # default: = PV_WP_REMOTE_TOKEN; besser in .secrets
# PV_WP_BRIDGE_RATE_LIMIT_PER_MIN=60
# PV_WP_BRIDGE_WRITE_LIMIT_PER_MIN=12

# ── Host-Rollen NACH REFORMATION (Zielbild) ─────────────────────────────────
#   Pi5-Primary  192.0.2.204  (admin) — Vollsystem A-E, WP via Bridge (remote)
#   Pi5-F&B      192.0.2.195  (admin) — Failover read-only + Backup + Ticker
#   Pi4-Kueche   192.0.2.105  (jk)    — Kiosk + Longterm-Backup (GFS monthly/yearly)
#   Pi4-Tech     192.0.2.181  (admin) — WP/HW-Bridge (WP_BACKEND_MODE=local)

# ── Longterm-Backup-Offload (Grossvater monthly/yearly -> Pi4-Kueche) ────────
# Nur auf dem Backup-Host (Pi5-FB) relevant. Fail-safe: leer/unerreichbar -> Skip.
# PV_KUECHE_HOST=<user>@192.0.2.105
# PV_KUECHE_ARCHIVE_BASE=pv-longterm-archive   # relativ zum Remote-Home

# ── Kiosk (Pi4-Kueche) ──────────────────────────────────────────────────────
# Dashboard-URL des Kiosk-Browsers zeigt auf den Primary (.204):
# PV_KIOSK_URL=http://192.0.2.204:8000
# PV_KIOSK_FULLSCREEN=0   # 0 = maximiert/touch-bedienbar (Default), 1 = echtes Vollbild