[Unit]
Description=PV Recovery-Selfcheck (Major-Version: Paket/USB-Aktualitaet, Mail)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=%h/Dokumente/PVAnlage/pv-system
ExecStart=%h/Dokumente/PVAnlage/pv-system/.venv/bin/python %h/Dokumente/PVAnlage/pv-system/recovery/recovery_selfcheck.py --build
StandardOutput=journal
StandardError=journal
Nice=15
