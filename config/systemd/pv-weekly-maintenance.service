[Unit]
Description=PV woechentlicher Wartungs-/Update-Melder (apt+pip Report per Mail)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=%h/Dokumente/PVAnlage/pv-system
ExecStart=%h/Dokumente/PVAnlage/pv-system/.venv/bin/python %h/Dokumente/PVAnlage/pv-system/scripts/pv_weekly_maintenance_report.py
StandardOutput=journal
StandardError=journal
Nice=15
