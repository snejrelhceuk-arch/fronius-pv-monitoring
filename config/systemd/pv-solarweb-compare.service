[Unit]
Description=PV Solarweb-Abgleich (Solarweb-CSV vs. daily_data, Mail)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
WorkingDirectory=%h/Dokumente/PVAnlage/pv-system
ExecStart=%h/Dokumente/PVAnlage/pv-system/.venv/bin/python %h/Dokumente/PVAnlage/pv-system/scripts/solarweb_compare.py
StandardOutput=journal
StandardError=journal
Nice=18
