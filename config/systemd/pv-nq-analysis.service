[Unit]
Description=PV-System NQ Netzereignis-Analyse VLF-only täglich (Primary, Rolle N)
Documentation=file:///opt/pv-system/doc/netzqualitaet/NQ_MODUL.md
After=pv-nq-aggregate.service

[Service]
Type=oneshot
User=admin
WorkingDirectory=/opt/pv-system
EnvironmentFile=-%h/.infra.local
Environment=PYTHONUNBUFFERED=1
# Analysiert den Vortag: nur VLF (HF/NF laufen alle 4h in separatem Service)
ExecStart=/bin/sh -c '/usr/bin/python3 -m nq.analysis.nq_events --date "$(date -d yesterday +%%Y-%%m-%%d)" --bands VLF'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pv-nq-analysis
NoNewPrivileges=true
