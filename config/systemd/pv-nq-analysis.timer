[Unit]
Description=NQ Netzereignis-Analyse täglich 00:30 (Primary, Rolle N; nach Transfer+Aggregation)
Documentation=https://github.com/mvk/pv-system/blob/main/doc/netzqualitaet/NQ_MODUL.md

[Timer]
# 00:30 — nach Energie-Rollup (00:05), Transfer (00:10) und Aggregation (00:15).
# Persistent = verpasste Läufe (z. B. nach Reboot) nachholen.
OnCalendar=*-*-* 00:30:00
Persistent=true
Unit=pv-nq-analysis.service

[Install]
WantedBy=timers.target
