[Unit]
Description=NQ Netzereignis-Analyse VLF-only täglich 00:30 (Primary, Rolle N)
Documentation=file:///opt/pv-system/doc/netzqualitaet/NQ_MODUL.md

[Timer]
# 00:30 — nach Energie-Rollup (00:05), Transfer (00:10), Aggregation (00:15).
# Persistent = verpasste Läufe (z. B. nach Reboot) nachholen.
OnCalendar=*-*-* 00:30:00
Persistent=true
Unit=pv-nq-analysis.service

[Install]
WantedBy=timers.target
